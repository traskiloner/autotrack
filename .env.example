# Application environment (production | development | test)
NODE_ENV=production

# Database configuration
DB_USER=postgres
DB_PASSWORD=your_secure_db_password_here
DB_NAME=autotrack
DB_HOST=localhost
DB_PORT=5432

# Database URL (optional, automatically built from DB_* if omitted)
# DATABASE_URL=postgresql://postgres:postgres_pass@localhost:5432/autotrack?schema=public

# JWT Authentication
# Optional: if left empty or omitted, AutoTrack automatically generates a secure
# random secret on first startup and persists it in the database (app_settings).
JWT_SECRET=your_secure_jwt_secret_here

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=example@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM="AutoTrack <example@gmail.com>"

# Optional overrides
# LOG_LEVEL=info
# CORS_ORIGINS=https://autotrack.traskiloner.com,http://localhost:4080,capacitor://localhost
